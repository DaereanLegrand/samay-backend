# Samay — Self-hosted Supabase environment TEMPLATE.
#
# ONE env per project: `make init` copies this to supabase/.env (gitignored,
# mode 600). Nothing secret is committed — replace every placeholder and mint
# the anon/service JWTs from JWT_SECRET before `make start`
# (`tools/gen_testing_anon_key.py` mints the anon key; the service_role key is
# the same JWT with role=service_role). Prod uses the vault-merged `server.env`
# on the VM, never this file.

# ── Docker Compose layering (DKR-02, M-06) ────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.pg17.yml:docker-compose.rustfs.yml:docker-compose.pushworker.yml:docker-compose.pushworker-build.yml

# ── Host port map — source of truth (DKR-03, M-02) ─────────────
POSTGRES_PORT=54382
STUDIO_PORT=54381
KONG_HTTP_PORT=54386
KONG_HTTPS_PORT=54443
MAILPIT_PORT=54384
ANALYTICS_PORT=54388

# ── Database ────────────────────────────────────────────────
POSTGRES_HOST=/var/run/postgresql
POSTGRES_DB=supabase
POSTGRES_DB_NAME=supabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGDATA=/var/lib/postgresql/data/pgdata

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXP=3600
JWT_AUD=authenticated
JWT_ADMIN_ROLES=service_role

# ── API ─────────────────────────────────────────────────────
SITE_URL=https://samay-api.qallariy.lat
ADDITIONAL_REDIRECT_URLS=
API_EXTERNAL_URL=https://samay-api.qallariy.lat

# App-level URLs (public; the Go CLI reads these via godotenv from this file).
SUPABASE_URL=https://samay-api-testing.qallariy.lat
API_TESTING_URL=https://samay-api-testing.qallariy.lat
API_PROD_URL=https://samay-api.qallariy.lat

# ── Auth ────────────────────────────────────────────────────
AUTH_ENABLED=true
AUTH_SITE_URL=https://samay-api.qallariy.lat
AUTH_JWT_SECRET=your-jwt-secret-change-in-production
AUTH_JWT_DEFAULT_EXP=3600
AUTH_JWT_AUD=authenticated
AUTH_JWT_ADMIN_ROLES=service_role
AUTH_EXTERNAL_EMAIL_ENABLED=true
AUTH_EXTERNAL_PHONE_ENABLED=false
AUTH_SMTP_ADMIN_EMAIL=samayverif@qallariy.lat
AUTH_SMTP_HOST=smtp.purelymail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=samayverif@qallariy.lat
AUTH_SMTP_PASS=your-smtp-password
AUTH_SMTP_SENDER_NAME=Samay
AUTH_DISABLE_SIGNUP=false
AUTH_RATE_LIMIT_EMAIL_SENT=2

# ── SMTP Email Subjects ─────────────────────────────────────
AUTH_MAILER_SUBJECTS_CONFIRMATION="Confirma tu correo — Samay"
AUTH_MAILER_SUBJECTS_RECOVERY="Recupera tu contraseña — Samay"
AUTH_MAILER_SUBJECTS_EMAIL_CHANGE="Confirma tu nuevo correo — Samay"

# ── Google OAuth (GoTrue external provider) ─────────────────
# Public client ids (testing project); the Web client SECRET is owner-only and
# read from the vault on staging/prod. Comma-joined WEB-FIRST.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://samay-api-testing.qallariy.lat/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_SKIP_NONCE_CHECK=true
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# ── Apple OAuth (GoTrue external provider) ──────────────────
# Native iOS Sign in with Apple: the client id is the App ID (bundle id); no
# Services ID / ES256 secret needed for the native flow.
GOTRUE_EXTERNAL_APPLE_ENABLED=true
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=com.qallariy.samay
GOTRUE_EXTERNAL_APPLE_REDIRECT_URI=https://samay-api-testing.qallariy.lat/auth/v1/callback

# ── Realtime ────────────────────────────────────────────────
REALTIME_PORT=4000
REALTIME_JWT_SECRET=your-jwt-secret-change-in-production
REALTIME_DB_ENC_KEY=supabase-realtime-encryption-key-change-in-production

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=file
STORAGE_FILE_SIZE_LIMIT=314572800
STORAGE_TENANT_ID=samay
STORAGE_BUCKET=samay-storage
STORAGE_REGION=us-east-1

# ── Studio ──────────────────────────────────────────────────
STUDIO_PG_META_URL=http://meta:8080
SUPABASE_PUBLIC_URL=http://127.0.0.1:54386

# ── Pooler ──────────────────────────────────────────────────
POOLER_ENABLED=false
POOLER_TENANT_ID=samay
POOLER_PORT=54329

# ── Meta ────────────────────────────────────────────────────
META_PORT=8080

# ── Analytics / Grafana / Vector ───────────────────────────
ANALYTICS_ENABLED=false
GRAFANA_ENABLED=false
GRAFANA_PORT=3001
VECTOR_ENABLED=false

# ── SMTP ────────────────────────────────────────────────────
SMTP_ADMIN_EMAIL=samayverif@qallariy.lat
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=587
SMTP_USER=samayverif@qallariy.lat
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Samay

# ── Supabase Keys (mint from JWT_SECRET before `make start`) ──
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Docker Compose Overrides ───────────────────────────────
COMPOSE_PROJECT_NAME=samay
