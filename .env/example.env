# Samay — testing-local stack template.
#
# `make init ENV=testing-local` copies this to .env/testing-local.env
# (gitignored, mode 600) and mints JWT_SECRET plus the anon/service keys
# (tools/gen-local-env.sh). Nothing secret is committed.
#
# ENV=testing does NOT use this file: .env/testing.env is a secret-free layout
# and its public values and secrets all come from the vault.

# ── Docker Compose layering ─────────────────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.pg17.yml:docker-compose.rustfs.yml:docker-compose.pushworker.yml:docker-compose.pushworker-build.yml

# ── Stack identity ──────────────────────────────────────────
STACK_PREFIX=samay-testing-local
STORAGE_DIR=./volumes/testing-local/storage

# ── Host port map — NEVER Juega's 5432/54321/54323/8443 ─────
POSTGRES_PORT=54392
STUDIO_PORT=54391
KONG_HTTP_PORT=54396
KONG_HTTPS_PORT=54453
MAILPIT_PORT=54394

# ── Public URLs (local Kong; Mailpit receives the mail) ─────
SITE_URL=http://127.0.0.1:54396
API_EXTERNAL_URL=http://127.0.0.1:54396

# ── Secrets — minted by `make init`, never committed ────────
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REALTIME_SECRET_KEY_BASE=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ── Storage ─────────────────────────────────────────────────
GLOBAL_S3_BUCKET=samay-storage
STORAGE_FILE_SIZE_LIMIT=314572800
IMGPROXY_AUTO_WEBP=true

# ── Auth toggles (guest-first slim build) ───────────────────
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=true
GOTRUE_SECURITY_MANUAL_LINKING_ENABLED=true
AUTH_RATE_LIMIT_EMAIL_SENT=100
FUNCTIONS_VERIFY_JWT=true

# ── Google / Apple sign-in ──────────────────────────────────
# Public client ids (web first, then iOS) — the same pair the testing GCP project
# uses, so a local stack also accepts native sign-in. The web client SECRET is
# owner-only and never lives here.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=384058632735-dcmjlck6kod0ud9bco4374nfbcmdgcrl.apps.googleusercontent.com,384058632735-a8m49o8s6q7s5hmbbic0or2so64qedaj.apps.googleusercontent.com
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:54396/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_SKIP_NONCE_CHECK=true
# Native id_token flow: the client id is the App ID (bundle id); no secret.
GOTRUE_EXTERNAL_APPLE_ENABLED=true
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=com.qallariy.samay
GOTRUE_EXTERNAL_APPLE_SECRET=
GOTRUE_EXTERNAL_APPLE_REDIRECT_URI=http://127.0.0.1:54396/auth/v1/callback

# ── Edge functions / push / RevenueCat (opt-in per run) ─────
SYSTEM_ADMIN_USER_ID=
PUSH_POLL_INTERVAL=15s
PUSH_BATCH_SIZE=100
PUSHWORKER_IMAGE=samay-pushworker:local
SUPABASE_FCM_SERVICE_ACCOUNT_JSON_B64=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=

# ── Go CLI / API (read via godotenv from this file) ─────────
SAMAY_ADMIN_USER_ID=
TRUSTED_PROXIES=
