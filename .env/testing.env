# Samay — ENV=testing LAYOUT (non-secret, deployment facts only).
#
# Ports, stack identity, storage dir, toggles. NOTHING else: public URLs and
# provider client ids are vault values (qallariy/samay/testing/public/*), exactly
# as staging sources them, and every secret comes from the same vault profile.
# `tools/start-stack.sh` fetches that profile and overlays it here in a RAM dir.
#
# Reading this file yields no URL beyond the host port and no credential.

# ── Docker Compose layering ─────────────────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.pg17.yml:docker-compose.rustfs.yml:docker-compose.pushworker.yml:docker-compose.pushworker-build.yml

# ── Stack identity ──────────────────────────────────────────
STACK_PREFIX=samay-testing
STORAGE_DIR=./volumes/testing/storage

# ── Host port map — NEVER Juega's 5432/54321/54323/8443 ─────
POSTGRES_PORT=54382
STUDIO_PORT=54381
KONG_HTTP_PORT=54386
KONG_HTTPS_PORT=54443
MAILPIT_PORT=54384

# ── Storage / edge toggles ──────────────────────────────────
GLOBAL_S3_BUCKET=samay-storage
STORAGE_FILE_SIZE_LIMIT=314572800
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=true

# ── Auth toggles (guest-first slim build) ───────────────────
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=true
GOTRUE_SECURITY_MANUAL_LINKING_ENABLED=true
AUTH_RATE_LIMIT_EMAIL_SENT=100
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_SKIP_NONCE_CHECK=true
GOTRUE_EXTERNAL_APPLE_ENABLED=true

# ── Push worker (opt-in per run with FCM=true) ─────────────
PUSH_BATCH_SIZE=100
PUSH_POLL_INTERVAL=15s
PUSHWORKER_IMAGE=samay-pushworker:local
